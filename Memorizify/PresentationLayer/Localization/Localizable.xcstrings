        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení timeru"
          }
        }
      }
    },
    "To change notifications settings, System Settings will open. Please select your notification preferences there." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro změnu nastavení upozornění je nutné otevřít systémové nastavení. Upozornění lze změnit tam."
          }
        }
      }
    },
    "To change the language, System Settings will open. Please select your desired laguage there." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro změnu jazyka je nutné otevřít systémové nastavení. Jazyk lze změnit tam."
          }
        }
      }
    },
    "to guild" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "do cechu"
          }
        }
      }
    },
    "To verify your account, please click on the verification link in your email. Then, you'll be able to log in." : {
      "localizations" : {
