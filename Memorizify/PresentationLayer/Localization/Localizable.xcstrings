          }
        }
      }
    },
    "Form a guild with your friends and embark on a collaborative studying journey together. Compare progress, engage in friendly competition, and most importantly, enjoy the process of learning as a team!" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte s přáteli cech a vydejte se na společnou cestu studiem plnou spolupráce. Porovnávejte pokrok, zapojte se do soupeření a především si užijte proces společného učení!"
          }
        }
      }
    },
