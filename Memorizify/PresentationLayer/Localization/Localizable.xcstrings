    "Leave Guild" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opustit cech"
          }
        }
      }
    },
    "Lia, recognizing the dragon's kind intentions, clung to his warm scales. Together, they emerged at the edge of the village, under the watchful eyes of the stunned crowd." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lia, poznávající drakovy laskavé úmysly, se držela jeho teplých šupin. Společně se objevili na okraji vesnice pod pozornými pohledy ohromeného davu."
          }
        }
      }
    },
    "Lia's Testimony" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liina svědectví"
          }
        }
