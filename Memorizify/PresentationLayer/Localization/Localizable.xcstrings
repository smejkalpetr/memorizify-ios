    "A Blossoming Friendship" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozkvétající přátelství"
          }
        }
      }
    },
    "A Dive into Fame" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponor do slávy"
          }
        }
      }
    },
    "A group of curious bees visited, intrigued by Fang's antics, leaving Petal to host a pollen party to show the beauty of her vegetarian ways." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupina zvědavých včel navštívila zahradu, přilákána Fangovými kousky, zatímco Petal uspořádala pylouvou oslavu, aby ukázala krásu svého vegetariánského způsobu života."
          }
        }
      }
    },
    "A New Perspective" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nový pohled"
          }
        }
      }
    },
    "A Thirst for More" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chce to více"
          }
        }
      }
    },
    "A well-meaning octopus tried to remove the bottle top, resulting in a slapstick series of failed attempts that only added to Tilly's internet fame." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobře míněný chobotnice se pokusil odstranit vršek lahve, což vyústilo v sérii komických neúspěšných pokusů, které jen přidaly na Tillyině internetové slávě."
          }
        }
      }
    },
    "Accept" : {
